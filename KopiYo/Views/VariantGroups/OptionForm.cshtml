@model KopiYo.ViewModels.Variants.VariantOptionFormViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Tambah Opsi Varian" : "Ubah Opsi Varian";
}

<h1 class="h4 mb-1">@ViewData["Title"]</h1>
<p class="text-muted">Grup: <strong>@Model.GroupName</strong></p>

<div class="card">
    <div class="card-body" style="max-width: 40rem;">
        <form asp-action="@(isNew ? "CreateOption" : "EditOption")" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="Id"/>
            <input type="hidden" asp-for="VariantGroupId"/>
            <input type="hidden" asp-for="GroupName"/>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autofocus placeholder="mis. L, Ice, Extra Shot"/>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PriceDelta" class="form-label"></label>
                <div class="input-group" style="max-width: 14rem;">
                    <span class="input-group-text">Rp</span>
                    <input asp-for="PriceDelta" class="form-control" type="number" step="500" min="0"/>
                </div>
                <div class="form-text">
                    Ditambahkan ke harga dasar produk. Isi 0 kalau tidak menambah harga.
                    Mengubah nilai ini hanya berlaku untuk penjualan berikutnya &mdash;
                    struk lama tetap memakai harga saat transaksinya terjadi.
                </div>
                <span asp-validation-for="PriceDelta" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" class="form-control" style="max-width: 8rem;"/>
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input"/>
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-dark">Simpan</button>
            <a class="btn btn-link" asp-action="Index">Batal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
