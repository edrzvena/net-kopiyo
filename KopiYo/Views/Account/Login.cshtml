@model KopiYo.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Masuk";
    Layout = "_LoginLayout";
}

<div class="login-card">
    <div class="card-body p-4 p-lg-4">
        <div class="mb-4">
            <div class="login-mark mb-3">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 9h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9Z"/>
                    <path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17"/>
                    <path d="M8 2.5v2.6M12 2.5v2.6"/>
                </svg>
            </div>
            <h1 class="h5 mb-1">Masuk ke KopiYo</h1>
            <p class="text-muted small mb-0">Sistem kasir cafe</p>
        </div>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            @* Ringkasan error non-field: "Username atau password salah." muncul di sini. *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus/>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password"/>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input"/>
                <label asp-for="RememberMe" class="form-check-label small"></label>
            </div>

            <button type="submit" class="btn btn-dark w-100 py-2">Masuk</button>
        </form>
    </div>
</div>

@if (ViewContext.HttpContext.RequestServices
         .GetRequiredService<IWebHostEnvironment>().IsDevelopment())
{
    @* Latar login sekarang terang, jadi text-white-50/text-warning tidak terbaca lagi. *@
    <div class="text-center text-muted small mt-3">
        Akun bawaan (development): <code>admin / Admin123!</code>
        &middot; <code>kasir / Kasir123!</code>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
