@model KopiYo.ViewModels.Shared.PagedList<KopiYo.ViewModels.Orders.OrderListItemViewModel>
@using KopiYo.Common
@{
    ViewData["Title"] = "Riwayat Transaksi";
    var from = ViewData["From"] as DateOnly?;
    var to = ViewData["To"] as DateOnly?;
    var status = ViewData["Status"] as OrderStatus?;
}

<h1 class="h4 mb-3">Riwayat Transaksi</h1>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label small mb-0">Dari</label>
        <input type="date" name="from" class="form-control" value="@(from?.ToString("yyyy-MM-dd"))"/>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0">Sampai</label>
        <input type="date" name="to" class="form-control" value="@(to?.ToString("yyyy-MM-dd"))"/>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0">Status</label>
        <select name="status" class="form-select">
            <option value="">Semua</option>
            <option value="Paid" selected="@(status == OrderStatus.Paid)">Paid</option>
            <option value="Voided" selected="@(status == OrderStatus.Voided)">Voided</option>
            <option value="Refunded" selected="@(status == OrderStatus.Refunded)">Refunded</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0">Cari</label>
        <input type="text" name="search" class="form-control" value="@ViewData["Search"]"
               placeholder="No. order / kasir"/>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>No. Order</th>
                <th>Waktu</th>
                <th>Kasir</th>
                <th class="text-center">Item</th>
                <th class="text-center">Bayar</th>
                <th class="text-end">Total</th>
                <th class="text-center">Status</th>
                <th class="text-end">Aksi</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">Tidak ada transaksi.</td>
                </tr>
            }
            @foreach (var o in Model.Items)
            {
                <tr class="@(o.Status == OrderStatus.Paid ? "" : "text-muted")">
                    <td class="fw-semibold">@o.OrderNumber</td>
                    <td class="small text-nowrap">@o.OrderDate.ToString("dd/MM/yy HH:mm")</td>
                    <td>@o.CashierName</td>
                    <td class="text-center">@o.ItemCount</td>
                    <td class="text-center"><span class="badge bg-light text-dark">@o.PaymentMethod</span></td>
                    <td class="text-end">@o.GrandTotal.ToRupiah()</td>
                    <td class="text-center">
                        @switch (o.Status)
                        {
                            case OrderStatus.Paid:
                                <span class="badge bg-success">Paid</span>
                                break;
                            case OrderStatus.Voided:
                                <span class="badge bg-secondary">Voided</span>
                                break;
                            default:
                                <span class="badge bg-warning text-dark">Refunded</span>
                                break;
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@o.Id">Detail</a>
                        <a class="btn btn-sm btn-outline-dark" asp-action="Receipt" asp-route-id="@o.Id">Struk</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<p class="text-muted small">
    Transaksi yang dibatalkan atau di-refund tetap disimpan selamanya dan tidak
    pernah dihapus &mdash; menghapusnya akan menghancurkan jejak audit.
    Laporan omzet hanya menghitung yang berstatus <strong>Paid</strong>.
</p>

<partial name="_Pagination" model="Model"/>
