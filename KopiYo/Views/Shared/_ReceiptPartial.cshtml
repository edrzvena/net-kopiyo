@model KopiYo.DTOs.Pos.ReceiptDto
@using KopiYo.Common
@*
    Satu partial struk, dua pintu masuk: /Pos/Receipt/{id} (kasir, order sendiri)
    dan nanti /Orders/Receipt/{id} (admin, semua order).

    Semua angka di sini berasal dari kolom snapshot milik order, bukan dari tabel
    master — itulah kenapa mencetak ulang struk lama tetap menampilkan harga lama.
*@
<div id="receipt" class="receipt">
    <div class="text-center mb-2">
        <div class="fw-bold">@Model.CafeName</div>
        <div class="small">@Model.CafeAddress</div>
        <div class="small">@Model.CafePhone</div>
    </div>
    <hr/>

    <div class="small">@Model.OrderNumber</div>
    <div class="small">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</div>
    <div class="small">Kasir: @Model.CashierName</div>
    @if (Model.Status != OrderStatus.Paid)
    {
        <div class="fw-bold text-danger text-center border border-danger my-2 py-1">
            @(Model.Status == OrderStatus.Voided ? "DIBATALKAN" : "DIKEMBALIKAN")
        </div>
    }
    <hr/>

    @foreach (var line in Model.Lines)
    {
        <div class="small">
            @line.ProductName
            @if (!string.IsNullOrEmpty(line.VariantDescription))
            {
                <em>(@line.VariantDescription)</em>
            }
        </div>
        @if (!string.IsNullOrEmpty(line.Note))
        {
            <div class="small fst-italic">* @line.Note</div>
        }
        <div class="d-flex justify-content-between small">
            <span>@line.Quantity x @line.UnitPrice.ToRupiah()</span>
            <span>@line.LineTotal.ToRupiah()</span>
        </div>
    }

    <hr/>
    <div class="d-flex justify-content-between small">
        <span>Subtotal</span><span>@Model.Subtotal.ToRupiah()</span>
    </div>
    @if (Model.DiscountAmount > 0)
    {
        <div class="d-flex justify-content-between small">
            <span>Diskon</span><span>-@Model.DiscountAmount.ToRupiah()</span>
        </div>
    }
    @if (Model.ServiceChargeAmount > 0)
    {
        <div class="d-flex justify-content-between small">
            <span>Service @Model.ServiceChargePercent%</span><span>@Model.ServiceChargeAmount.ToRupiah()</span>
        </div>
    }
    @if (Model.TaxAmount > 0)
    {
        <div class="d-flex justify-content-between small">
            <span>Pajak @Model.TaxPercent%</span><span>@Model.TaxAmount.ToRupiah()</span>
        </div>
    }
    <div class="d-flex justify-content-between fw-bold">
        <span>TOTAL</span><span>@Model.GrandTotal.ToRupiah()</span>
    </div>
    <div class="d-flex justify-content-between small">
        <span>Bayar (@Model.PaymentMethod)</span><span>@Model.AmountPaid.ToRupiah()</span>
    </div>
    <div class="d-flex justify-content-between fs-5 fw-bold mt-2">
        <span>KEMBALI</span><span>@Model.ChangeAmount.ToRupiah()</span>
    </div>

    <div class="text-center small mt-3">Terima kasih!</div>
</div>
