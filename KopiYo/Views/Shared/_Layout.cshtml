@{
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsAdmin();
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - KopiYo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/KopiYo.styles.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-4">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                @* Ikon garis, bukan emoji: emoji dirender berbeda di tiap OS
                   dan ukurannya tidak bisa disamakan dengan tinggi teks. *@
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 9h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9Z"/>
                    <path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17"/>
                    <path d="M8 2.5v2.6M12 2.5v2.6"/>
                </svg>
                KopiYo
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                @*
                    CATATAN PENTING: menyembunyikan link di sini murni soal tampilan,
                    BUKAN batas keamanan. Batas keamanan yang sebenarnya adalah
                    [Authorize(Roles = "Admin")] di class controller-nya. Kasir yang
                    mengetik /Products langsung di address bar tetap ditolak middleware.
                *@
                <ul class="navbar-nav flex-grow-1">
                    @if (isAuthed)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Pos" asp-action="Index">Kasir</a>
                        </li>
                    }
                    @if (isAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Master Data</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">Kategori</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Produk</a></li>
                                <li><a class="dropdown-item" asp-controller="VariantGroups" asp-action="Index">Varian</a></li>
                                <li>
                                    <a class="dropdown-item d-flex justify-content-between align-items-center"
                                       asp-controller="Ingredients" asp-action="Index">
                                        Bahan Baku
                                        <span class="badge bg-danger d-none" id="low-stock-badge"></span>
                                    </a>
                                </li>
                                <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Pengguna</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Laporan</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="Dashboard">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="Sales">Penjualan</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="ByCashier">Per Kasir</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="BestSellers">Menu Terlaris</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">Riwayat Transaksi</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    @if (isAuthed)
                    {
                        <li class="nav-item me-2">
                            <span class="navbar-text">
                                @User.GetFullName()
                                <span class="badge @(isAdmin ? "bg-warning text-dark" : "bg-info text-dark")">
                                    @(isAdmin ? "Admin" : "Kasir")
                                </span>
                            </span>
                        </li>
                        <li class="nav-item">
                            @* Logout WAJIB POST — link GET bisa dipicu CSRF dan ter-prefetch browser. *@
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light">Keluar</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container-fluid px-3 px-lg-4">
    <main role="main" class="pb-3">
        <partial name="_StatusMessage"/>
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (isAdmin)
{
    <script>
        // Badge stok menipis. Sengaja dimuat setelah halaman siap dan gagal diam-diam:
        // ini informasi tambahan, bukan sesuatu yang boleh menghambat kerja Admin.
        fetch('/api/admin/ingredients/low-stock', { headers: { 'Accept': 'application/json' } })
            .then(r => r.ok ? r.json() : [])
            .then(items => {
                if (!items.length) return;
                const badge = document.getElementById('low-stock-badge');
                badge.textContent = items.length;
                badge.title = items.map(i => i.name).join(', ');
                badge.classList.remove('d-none');
            })
            .catch(() => { });
    </script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
