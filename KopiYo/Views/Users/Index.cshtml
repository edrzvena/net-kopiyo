@model KopiYo.ViewModels.Shared.PagedList<KopiYo.ViewModels.Users.UserListItemViewModel>
@using KopiYo.Common
@{
    ViewData["Title"] = "Pengguna";
    var currentUserId = User.GetUserId();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Pengguna</h1>
        <p class="text-muted small mb-0">
            <strong>Admin</strong> bisa mengelola semuanya.
            <strong>Kasir</strong> hanya bisa membuka layar kasir dan menginput penjualan.
        </p>
    </div>
    <a class="btn btn-dark" asp-action="Create">+ Tambah Pengguna</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control"
               placeholder="Cari username atau nama..."/>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-secondary">Cari</button>
    </div>
</form>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>Username</th>
                <th>Nama Lengkap</th>
                <th class="text-center">Role</th>
                <th class="text-center">Transaksi</th>
                <th class="text-center">Status</th>
                <th class="text-end">Aksi</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="@(item.IsActive ? "" : "text-muted")">
                    <td>
                        <span class="fw-semibold">@item.Username</span>
                        @if (item.Id == currentUserId)
                        {
                            <span class="badge bg-primary">Anda</span>
                        }
                    </td>
                    <td>@item.FullName</td>
                    <td class="text-center">
                        <span class="badge @(item.Role == UserRole.Admin ? "bg-warning text-dark" : "bg-info text-dark")">
                            @item.Role
                        </span>
                    </td>
                    <td class="text-center">@item.OrderCount</td>
                    <td class="text-center">
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nonaktif</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Ubah</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="ResetPassword" asp-route-id="@item.Id">Reset Password</a>
                        @*
                            User tidak pernah dihapus: Order menyimpan CashierId yang
                            merujuk ke sini, dan riwayat penjualan harus tetap utuh.
                        *@
                        @if (item.Id != currentUserId)
                        {
                            <form asp-action="SetActive" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id"/>
                                <input type="hidden" name="isActive" value="@((!item.IsActive).ToString().ToLowerInvariant())"/>
                                <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                    @(item.IsActive ? "Nonaktifkan" : "Aktifkan")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model"/>
