@model KopiYo.ViewModels.Users.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<h1 class="h4 mb-1">Reset Password</h1>
<p class="text-muted">Untuk user: <strong>@Model.Username</strong></p>

<div class="card">
    <div class="card-body" style="max-width: 32rem;">
        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="Id"/>
            <input type="hidden" asp-for="Username"/>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus/>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-dark">Ganti Password</button>
            <a class="btn btn-link" asp-action="Index">Batal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
