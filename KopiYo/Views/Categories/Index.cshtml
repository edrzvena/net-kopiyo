@model IReadOnlyList<KopiYo.ViewModels.Categories.CategoryListItemViewModel>
@{
    ViewData["Title"] = "Kategori";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Kategori Menu</h1>
    <a class="btn btn-dark" asp-action="Create">+ Tambah Kategori</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th style="width: 5rem;">Urutan</th>
                <th>Nama</th>
                <th>Deskripsi</th>
                <th class="text-center">Produk Aktif</th>
                <th class="text-center">Status</th>
                <th class="text-end">Aksi</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Belum ada kategori.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr class="@(item.IsActive ? "" : "text-muted")">
                    <td>@item.DisplayOrder</td>
                    <td class="fw-semibold">@item.Name</td>
                    <td class="small">@item.Description</td>
                    <td class="text-center">@item.ProductCount</td>
                    <td class="text-center">
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nonaktif</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Ubah</a>
                        @*
                            Tidak ada tombol Hapus di seluruh aplikasi ini.
                            Kategori dirujuk produk, dan produk dirujuk riwayat order —
                            menghapusnya akan merusak laporan penjualan lama.
                        *@
                        <form asp-action="SetActive" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id"/>
                            <input type="hidden" name="isActive" value="@((!item.IsActive).ToString().ToLowerInvariant())"/>
                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                @(item.IsActive ? "Nonaktifkan" : "Aktifkan")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
