@model KopiYo.ViewModels.Ingredients.StockAdjustmentViewModel
@{
    ViewData["Title"] = "Sesuaikan Stok";
}

<h1 class="h4 mb-1">Sesuaikan Stok</h1>
<p class="text-muted">Bahan: <strong>@Model.IngredientName</strong></p>

<div class="card">
    <div class="card-body" style="max-width: 34rem;">
        <form asp-action="Adjust" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="IngredientId"/>
            <input type="hidden" asp-for="IngredientName"/>
            <input type="hidden" asp-for="UnitLabel"/>
            <input type="hidden" asp-for="CurrentStock"/>

            <div class="mb-3">
                <label class="form-label">Stok Tercatat Sekarang</label>
                <input class="form-control-plaintext fw-semibold"
                       readonly value="@Model.CurrentStock.ToQty() @Model.UnitLabel"/>
            </div>

            <div class="mb-3">
                <label asp-for="NewQty" class="form-label"></label>
                <div class="input-group" style="max-width: 16rem;">
                    <input asp-for="NewQty" class="form-control" type="number" step="0.001" min="0" autofocus/>
                    <span class="input-group-text">@Model.UnitLabel</span>
                </div>
                <div class="form-text">
                    Isi jumlah yang <strong>sebenarnya ada</strong>, bukan selisihnya.
                    Sistem yang menghitung selisih dan mencatatnya.
                </div>
                <span asp-validation-for="NewQty" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Reason" class="form-label"></label>
                <input asp-for="Reason" class="form-control"
                       placeholder="mis. Pembelian 5kg biji kopi / Stock opname / Tumpah"/>
                <div class="form-text">
                    Alasan ini tersimpan permanen di buku besar stok bersama nilai
                    sebelum dan sesudahnya &mdash; itulah yang membuat selisih stok
                    bisa ditelusuri berbulan-bulan kemudian.
                </div>
                <span asp-validation-for="Reason" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-dark">Simpan Penyesuaian</button>
            <a class="btn btn-link" asp-action="Index">Batal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
