@model KopiYo.ViewModels.Shared.PagedList<KopiYo.ViewModels.Ingredients.StockMovementListItemViewModel>
@using KopiYo.Common
@{
    ViewData["Title"] = "Buku Besar Stok";
    var from = ViewData["From"] as DateTime?;
    var to = ViewData["To"] as DateTime?;
}

<h1 class="h4 mb-1">Buku Besar Stok</h1>
<p class="text-muted small">
    Catatan ini hanya bertambah &mdash; tidak pernah diubah atau dihapus.
    Kolom <em>Sebelum</em> dan <em>Sesudah</em> memungkinkan kamu memutar ulang riwayat
    dan menemukan persis di mana angka stok mulai melenceng.
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="hidden" name="ingredientId" value="@ViewData["IngredientId"]"/>
        <label class="form-label small mb-0">Dari</label>
        <input type="date" name="from" class="form-control" value="@(from?.ToString("yyyy-MM-dd"))"/>
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-0">Sampai</label>
        <input type="date" name="to" class="form-control" value="@(to?.ToString("yyyy-MM-dd"))"/>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <a class="btn btn-link" asp-action="Movements">Reset</a>
    </div>
</form>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>Waktu</th>
                <th>Bahan</th>
                <th class="text-center">Jenis</th>
                <th class="text-end">Jumlah</th>
                <th class="text-end">Sebelum</th>
                <th class="text-end">Sesudah</th>
                <th>Alasan</th>
                <th>Oleh</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">Belum ada pergerakan stok.</td>
                </tr>
            }
            @foreach (var m in Model.Items)
            {
                <tr>
                    <td class="text-nowrap small">@m.CreatedAt.ToString("dd/MM/yy HH:mm:ss")</td>
                    <td>@m.IngredientName</td>
                    <td class="text-center">
                        @switch (m.MovementType)
                        {
                            case StockMovementType.In:
                                <span class="badge bg-success">Masuk</span>
                                break;
                            case StockMovementType.Out:
                                <span class="badge bg-danger">Keluar</span>
                                break;
                            default:
                                <span class="badge bg-primary">Koreksi</span>
                                break;
                        }
                    </td>
                    <td class="text-end">
                        @(m.MovementType == StockMovementType.Out ? "-" : "+")@m.Quantity.ToQty()
                        <span class="text-muted small">@m.UnitLabel</span>
                    </td>
                    <td class="text-end text-muted">@m.StockBefore.ToQty()</td>
                    <td class="text-end fw-semibold">@m.StockAfter.ToQty()</td>
                    <td class="small">@m.Reason</td>
                    <td class="small">@m.UserName</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model"/>
