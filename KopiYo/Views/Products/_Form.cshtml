@model KopiYo.ViewModels.Products.ProductFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
<input type="hidden" asp-for="Id"/>

<div class="row g-3">
    <div class="col-md-7">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus/>
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-5">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select" asp-items="Model.Categories">
            <option value="">-- pilih kategori --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="BasePrice" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">Rp</span>
            <input asp-for="BasePrice" class="form-control" type="number" step="500" min="0"/>
        </div>
        <div class="form-text">Harga sebelum tambahan varian, pajak, dan service charge.</div>
        <span asp-validation-for="BasePrice" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Sku" class="form-label"></label>
        <input asp-for="Sku" class="form-control"/>
        <span asp-validation-for="Sku" class="text-danger small"></span>
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="IsActive" class="form-check-input"/>
            <label asp-for="IsActive" class="form-check-label"></label>
            <div class="form-text">Produk nonaktif tidak muncul di layar kasir.</div>
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" placeholder="/img/latte.jpg"/>
        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
    </div>
</div>

<hr class="my-4"/>

<h2 class="h6">Grup Varian</h2>
<p class="text-muted small">
    Centang grup yang berlaku untuk produk ini. Opsi dan harganya diatur di menu
    <a asp-controller="VariantGroups" asp-action="Index">Varian</a>, bukan di sini &mdash;
    jadi mengubah harga "Extra Shot" cukup sekali untuk semua produk.
</p>

<div class="row g-2 mb-3">
    @if (Model.VariantGroups.Count == 0)
    {
        <div class="col-12">
            <div class="alert alert-warning py-2 small mb-0">Belum ada grup varian aktif.</div>
        </div>
    }
    @foreach (var group in Model.VariantGroups)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="form-check border rounded p-2 ps-4">
                <input class="form-check-input" type="checkbox" name="SelectedVariantGroupIds"
                       value="@group.Id" id="vg-@group.Id" checked="@group.Selected"/>
                <label class="form-check-label" for="vg-@group.Id">
                    @group.Label
                    <span class="d-block text-muted small">@group.Hint</span>
                </label>
            </div>
        </div>
    }
</div>

<button type="submit" class="btn btn-dark">Simpan</button>
<a class="btn btn-link" asp-action="Index">Batal</a>
